{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"cli": {
		"packageManager": "npm",
		"analytics": false
	},
	"newProjectRoot": "projects",
	"projects": {
		"typhoon": {
			"projectType": "application",
			"schematics": {},
			"root": "projects/typhoon",
			"sourceRoot": "projects/typhoon/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/typhoon",
						"tsConfig": "projects/typhoon/tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/typhoon/public",
								"output": "."
							}
						],
						"styles": [
							"projects/typhoon/src/styles.css"
						],
						"main": "projects/typhoon/src/main.ts",
						"index": "projects\\typhoon\\src\\index.html",
						"extraWebpackConfig": "projects/typhoon/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/typhoon/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "typhoon:build:production",
							"extraWebpackConfig": "projects/typhoon/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "typhoon:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4202,
						"publicHost": "http://localhost:4202",
						"extraWebpackConfig": "projects/typhoon/webpack.config.js"
					}
				},
				"test": {
					"builder": "@angular/build:unit-test"
				}
			}
		},
